{
  "name": "delivery-chaos",
  "version": "0.1.0",
  "private": true,
  "description": "外卖大乱送 / Delivery Chaos — chaotic co-op motorbike food-delivery web game",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
